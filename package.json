{
  "name": "eslint-plugin-better-cap-config",
  "version": "1.1.0",
  "description": "ESLint plugin to detect deprecated SAP CAP configurations",
  "keywords": [
    "cap-js",
    "cds",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "sap",
    "sap-cap"
  ],
  "homepage": "https://github.com/mauriciolauffer/eslint-plugin-better-cap-config#readme",
  "bugs": {
    "url": "https://github.com/mauriciolauffer/eslint-plugin-better-cap-config/issues"
  },
  "license": "MIT",
  "author": "Mauricio Lauffer",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauriciolauffer/eslint-plugin-better-cap-config.git"
  },
  "files": [
    "dist/",
    "docs/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:lint:json": "eslint -c cap-cds/eslint.config.js",
    "test:ci": "vitest run --reporter=junit --outputFile=./test-results/junit-report.xml",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxfmt && oxlint --fix",
    "lint:ci": "oxfmt --check && oxlint --format=github",
    "lint:json:stats": "SET TIMING=all && eslint -c cap-cds/eslint.config.js --quiet",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@humanwhocodes/momoa": "^3.3.10",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint-config-mlauffer-nodejs": "^3.1.1",
    "eslint-plugin-eslint-plugin": "^7.5.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@eslint/json": ">=1",
    "eslint": ">=9"
  },
  "packageManager": "pnpm@11.13.1"
}

{
  "name": "my-sap-cap-app",
  "version": "1.0.0",
  "private": true,
  "description": "My SAP CAP Node.js App",
  "license": "MIT",
  "workspaces": [
    "app/*"
  ],
  "type": "module",
  "scripts": {
    "start": "cds-serve",
    "lint": "eslint --cache",
    "undeploy": "cf undeploy my-sap-cap-app --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch": "cds watch"
  },
  "dependencies": {
    "@cap-js/attachments": "^1.1.8",
    "@cap-js/change-tracking": "^1.0.6",
    "@cap-js/hana": "^1.4.1",
    "@cap-js/notifications": "^0.2.3",
    "@sap/cds": "^8.4.0",
    "@sap/xsenv": "^5.1.0",
    "@sap/xssec": "^3",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1.7.6",
    "@sap/ux-specification": "^1.120.17",
    "eslint": "^9",
    "wdio-qunit-service": "^2"
  },
  "cds": {
    "sql": {
      "native_hana_associations": false,
      "collate": "USING ICU LOCALE 'en-US'"
    },
    "features": {
      "odata_new_adapter": false,
      "cds_validate": false,
      "bulk_inserts_via_rest": false,
      "compat_clone_appends": true,
      "compat_srv_getters": true,
      "legacy_srv_results": true,
      "odata_metadata_compat": true
    },
    "fiori": {
      "draft_compat": true,
      "direct_crud": true
    },
    "i18n": {
      "fatjson": true
    },
    "mcp": {
      "autoConfig": true
    },
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa",
        "telemetry": {
          "kind": "to-cloud-logging"
        }
      },
      "[hybrid]": {
        "db": "hana"
      },
      "notifications": {
        "destination": "SAP_Notifications",
        "[hybrid]": {
          "kind": "notify-to-rest"
        }
      }
    },
    "launchpad": {
      "version": "1.125.1"
    }
  },
  "sapux": [
    "app/customers",
    "app/products"
  ]
}

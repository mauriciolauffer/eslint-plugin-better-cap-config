{
  "requires": {
    "destinations": true,
    "html5-repo": true,
    "uaa": {
      "kind": "xsuaa"
    },
    "auth": {
      "[production]": {
        "kind": "xsuaa"
      },
      "[development]": {
        "kind": "mocked"
      }
    },
    "db": {
      "[production]": {
        "kind": "hana"
      },
      "[development]": {
        "kind": "sql"
      },
      "model": ["db", "srv"]
    },
    "db-ext": {
      "[development]": {
        "model": "db/test"
      },
      "[production]": {
        "model": "db/hana"
      }
    }
  },
  "cdsc": {
    "severities": {
      "odata-spec-violation-no-key": "Warning"
    }
  },
  "features": {
    "bulk_inserts_via_rest": false,
    "compat_clone_appends": true,
    "compat_srv_getters": true,
    "legacy_srv_results": true,
    "odata_metadata_compat": true
  },
  "fiori": {
    "direct_crud": true
  },
  "i18n": {
    "fatjson": true
  },
  "mcp": {
    "autoConfig": true
  },
  "sql": {
    "collate": "USING ICU LOCALE 'en-US'"
  }
}
